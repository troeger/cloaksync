# Test values for the minikube test environment. They match
# ../keycloak/realm-cluster.json and are not secret.
CS_LOG_LEVEL=DEBUG
CS_KCK_POLL_INTERVAL=30
CS_KCK_SERVER=http://keycloak.keycloak-test.svc:8080
CS_KCK_REALM=cluster
CS_KCK_CLIENT_ID=admin-cli
CS_KCK_CLIENT_SECRET=cloaksync-test-secret
CS_KCK_GROUP_UUID=755673fd-b62b-4062-bf04-323e3149efff
CS_KCK_ROLE_NAME=k8s-user
CS_K8S_USER_PREFIX=keycloak:
CS_K8S_OWNER_ROLE_NAME=namespace-owner
CS_K8S_OWNER_ROLE_BINDING_NAME=namespace-owner
CS_K8S_IGNORE_NAMESPACES=default,keycloak-test,cloaksync-test,kube-system,kube-public,kube-node-lease
CS_K8S_PRUNING_CHECK=false
CS_K8S_PRUNING_DELETE=false
